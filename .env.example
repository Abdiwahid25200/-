# ═══════════════════════════════════════════════════════════════
#  متغيّرات البيئة — تُضاف في Vercel ← Settings ← Environment Variables
#  🔒 لا تُنسخ القيم الحقيقية في هذا الملف ولا تُرفع على GitHub
# ═══════════════════════════════════════════════════════════════

# ── Firebase (الستّة أسطر من Project settings ← Your apps ← web) ──
# ملاحظة: NEXT_PUBLIC تعني أنها تصل للمتصفح — وهذا مقصود في Firebase.
# ما يحمي البيانات هو firestore.rules، لا إخفاء هذه المفاتيح.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── التحقق من آيدي ببجي (سرّي — لا يصل للمتصفح) ──
PUBG_ID_API=
