rules_version = '2';

/**
 * قواعد أمان Firestore — Ramaan Store
 *
 * ⚠️ درسٌ من الموقع القديم: كانت الطلبات مصفوفة واحدة يقرأها **أي شخص**،
 *    وفيها كلمات مرور الحسابات نصّاً صريحاً. هذه القواعد تمنع ذلك نهائياً:
 *
 *    ① كل طلب وثيقة مستقلّة — لا مصفوفة عملاقة يقرأها الجميع
 *    ② الزبون يرى طلباته هو فقط، ولا يرى طلبات غيره أبداً
 *    ③ بيانات التسليم الحسّاسة (كلمات مرور الحسابات المُباعة) في مجموعة
 *      فرعية `private` لا يقرأها إلا الأدمن — حتى صاحب الطلب لا يصل لها مباشرة
 *    ④ الزبون لا يستطيع تعديل سعر أو حالة طلبه بعد إنشائه
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── من هو الأدمن؟ ──
       وثيقة باسم الـuid داخل مجموعة admins. تُضاف يدوياً من Firebase Console،
       فلا يستطيع أحد ترقية نفسه لأن الكتابة في admins ممنوعة على الجميع. */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* ── المساعدون ──
       الصلاحية **للبريد** لا للمعرّف: صاحبة المتجر تعرف بريد مساعدها
       وتكتبه، أمّا المعرّف فلا يُعرف إلا بعد أوّل دخول — فلو بنينا عليه
       لَما استطاعت منح الصلاحية قبل أن يدخل.

       ⚠️ ومجموعة `staff` لا يكتبها إلا الأدمن (انظري قاعدتها أسفل):
          لو سُمح للمساعد بتعديلها لَمنح نفسه كل الأبواب في ثانية. */
    function staffDoc() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(staffDoc());
    }

    function staffCan(p) {
      return isStaff()
        && get(staffDoc()).data.get('active', true) != false
        && get(staffDoc()).data.get('can', {}).get(p, false) == true;
    }

    /** الأدمن يملك كل الأبواب · والمساعد ما فُتح له وحده */
    function canDo(p) {
      return isAdmin() || staffCan(p);
    }

    match /staff/{email} {
      // المساعد يقرأ وثيقته ليعرف أبوابه · وصاحبة المتجر تقرأ الكل
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.token.email == email);
      // 🔒 الكتابة لصاحبة المتجر وحدها — لا ترقية ذاتية
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;   // من Firebase Console فقط
    }

    /* ── ملفّات الزبائن ──
       رقم الهاتف الذي يُدخله الزبون بعد الدخول بجوجل (للتسليم عبر واتساب).
       كل زبون يقرأ ويكتب وثيقته وحده — ولا يرى أرقام غيره أبداً. */
    match /users/{uid} {

      /* 🔒 النقاط رصيدٌ ماليّ: الزبون **يقرأه ولا يكتبه**.
         بدون هذا الشرط يفتح أي زبون أدوات المتصفّح ويكتب لنفسه ما شاء،
         ثم يشتري به. الكتابة للأدمن وحده — من لوحة الإدارة. */
      function pointsUntouched() {
        let inNew = 'points' in request.resource.data;
        let inOld = resource != null && 'points' in resource.data;
        return (!inNew && !inOld)
          || (inNew && inOld
              && request.resource.data.points == resource.data.points);
      }

      allow read: if canDo('customers') || canDo('orders')
        || (isSignedIn() && request.auth.uid == uid);

      // الإدارة تكتب الرصيد · والزبون يكتب رقمه وحده بلا لمس النقاط
      allow create, update: if canDo('customers') || canDo('orders')
        || (isSignedIn()
        && request.auth.uid == uid
        && pointsUntouched()
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20);

      allow delete: if isAdmin();

      /* ── سجلّ حركات النقاط ──
         الزبون يقرأ سجلّه (من أين جاءت نقاطه؟) ولا يكتب فيه حرفاً.
         كل سطر: كم · لماذا · لأي طلب — فالإلغاء يعرف كم يخصم. */
      match /ledger/{entryId} {
        allow read: if canDo('customers') || canDo('orders')
          || (isSignedIn() && request.auth.uid == uid);
        allow write: if canDo('customers') || canDo('orders');
      }
    }

    /* ── الطلبات ── */
    match /orders/{orderId} {

      /* رصيد النقاط الحقيقي للزبون — من وثيقته لا من طلبه.
         بدونه يكتب الزبون `usePoints: 999999` فيطلب خصماً لا يملكه. */
      function balanceOf() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(p) && 'points' in get(p).data ? get(p).data.points : 0;
      }

      function validRedeem() {
        let d = request.resource.data;
        return !('usePoints' in d)
          || (d.usePoints is int && d.usePoints >= 0
              && d.usePoints <= balanceOf());
      }

      function validNewOrder() {
        let d = request.resource.data;
        return validRedeem()
          && d.uid == request.auth.uid
          && d.status == 'pending'                 // لا يبدأ الطلب مدفوعاً
          && d.total is number && d.total >= 0
          && d.code is string && d.code.size() <= 32
          && d.items is list && d.items.size() > 0 && d.items.size() <= 50
          && d.createdAt == request.time;          // لا يزوّر تاريخ الطلب
      }

      // الزبون يرى طلباته هو فقط · الأدمن يرى الكل
      allow read: if canDo('orders')
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() && validNewOrder();

      // بعد الإنشاء لا يملك الزبون تعديل شيء — الحالة والسعر بيد الإدارة
      allow update, delete: if canDo('orders');

      /* بيانات التسليم الحسّاسة — كلمات مرور الحسابات المُباعة وما شابه.
         الأدمن فقط. تُسلَّم للزبون عبر واتساب لا عبر الموقع. */
      match /private/{docId} {
        allow read, write: if canDo('orders');
      }
    }

    /* ── الدردشة المباشرة ──
       لكل زبون محادثة واحدة باسم الـuid، فلا يصل أحد لمحادثة غيره.
       الخطر الحقيقي هنا انتحال صفة المتجر: زبونٌ يكتب رسالة بتوقيع
       `admin` فيقنع غيره… لذلك الزبون لا يكتب إلا `from == 'user'`. */
    match /chats/{uid} {

      function ownerOrAdmin() {
        return isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }

      allow read: if ownerOrAdmin();

      // وثيقة المحادثة: آخر سطر ووقته، لترتيب المحادثات بلوحة الإدارة
      allow create, update: if ownerOrAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /messages/{msgId} {

        function validMsg() {
          let d = request.resource.data;
          return d.text is string
            && d.text.size() > 0
            && d.text.size() <= 2000
            && d.createdAt == request.time;      // لا يزوّر وقت الرسالة
        }

        allow read: if ownerOrAdmin();

        allow create: if validMsg() && (
          (isAdmin() && request.resource.data.from == 'admin')
          // الزبون يكتب باسمه هو فقط — لا ينتحل صفة المتجر
          || (isSignedIn() && request.auth.uid == uid
              && request.resource.data.from == 'user')
        );

        // لا تعديل ولا حذف للرسائل بعد إرسالها إلا للأدمن
        allow update, delete: if isAdmin();
      }
    }

    /* ── المنتجات والأقسام والإعدادات ──
       يقرأها الجميع (متجر عام) · لا يكتبها إلا الأدمن من لوحة الإدارة */
    match /products/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /packages/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /sections/{id}  { allow read: if true; allow write: if canDo('sections'); }

    /* الإعدادات وثائق مختلفة الأغراض، فلكلٍّ بابها:
       `points` لمن فُتحت له النقاط · `faq` لمن فُتحت له الأسئلة. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin()
        || (id == 'points' && staffCan('points'))
        || (id == 'faq' && staffCan('faq'));
    }

    /* ── أي شيء آخر: ممنوع ──
       الافتراض هو المنع، فأي مجموعة جديدة تحتاج قاعدة صريحة أعلاه. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
