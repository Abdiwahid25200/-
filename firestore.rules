rules_version = '2';

/**
 * قواعد أمان Firestore — Ramaan Store
 *
 * ⚠️ درسٌ من الموقع القديم: كانت الطلبات مصفوفة واحدة يقرأها **أي شخص**،
 *    وفيها كلمات مرور الحسابات نصّاً صريحاً. هذه القواعد تمنع ذلك نهائياً:
 *
 *    ① كل طلب وثيقة مستقلّة — لا مصفوفة عملاقة يقرأها الجميع
 *    ② الزبون يرى طلباته هو فقط، ولا يرى طلبات غيره أبداً
 *    ③ بيانات التسليم الحسّاسة (كلمات مرور الحسابات المُباعة) في مجموعة
 *      فرعية `private` لا يقرأها إلا الأدمن — حتى صاحب الطلب لا يصل لها مباشرة
 *    ④ الزبون لا يستطيع تعديل سعر أو حالة طلبه بعد إنشائه
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── من هو الأدمن؟ ──
       وثيقة باسم الـuid داخل مجموعة admins. تُضاف يدوياً من Firebase Console،
       فلا يستطيع أحد ترقية نفسه لأن الكتابة في admins ممنوعة على الجميع. */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* ── المساعدون ──
       الصلاحية **للبريد** لا للمعرّف: صاحبة المتجر تعرف بريد مساعدها
       وتكتبه، أمّا المعرّف فلا يُعرف إلا بعد أوّل دخول — فلو بنينا عليه
       لَما استطاعت منح الصلاحية قبل أن يدخل.

       ⚠️ ومجموعة `staff` لا يكتبها إلا الأدمن (انظري قاعدتها أسفل):
          لو سُمح للمساعد بتعديلها لَمنح نفسه كل الأبواب في ثانية. */
    function staffDoc() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(staffDoc());
    }

    function staffCan(p) {
      return isStaff()
        && get(staffDoc()).data.get('active', true) != false
        && get(staffDoc()).data.get('can', {}).get(p, false) == true;
    }

    /** الأدمن يملك كل الأبواب · والمساعد ما فُتح له وحده */
    function canDo(p) {
      return isAdmin() || staffCan(p);
    }

    match /staff/{email} {
      // المساعد يقرأ وثيقته ليعرف أبوابه · وصاحبة المتجر تقرأ الكل
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.token.email == email);
      // 🔒 الكتابة لصاحبة المتجر وحدها — لا ترقية ذاتية
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;   // من Firebase Console فقط
    }

    /* ── ملفّات الزبائن ──
       رقم الهاتف الذي يُدخله الزبون بعد الدخول بجوجل (للتسليم عبر واتساب).
       كل زبون يقرأ ويكتب وثيقته وحده — ولا يرى أرقام غيره أبداً. */
    match /users/{uid} {

      /* 🔒 النقاط رصيدٌ ماليّ: الزبون **يقرأه ولا يكتبه**.
         بدون هذا الشرط يفتح أي زبون أدوات المتصفّح ويكتب لنفسه ما شاء،
         ثم يشتري به. الكتابة للأدمن وحده — من لوحة الإدارة. */
      function pointsUntouched() {
        let inNew = 'points' in request.resource.data;
        let inOld = resource != null && 'points' in resource.data;
        return (!inNew && !inOld)
          || (inNew && inOld
              && request.resource.data.points == resource.data.points);
      }

      /* الإنفاق: الرصيد **ينقص ولا يزيد**. أسوأ ما يفعله الزبون بنفسه
         أن يُتلف نقاطه، ولا يستطيع أن يخلق منها واحدة. */
      function pointsSpentOnly() {
        return resource != null
          && 'points' in resource.data
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points < resource.data.points;
      }

      allow read: if canDo('customers') || canDo('orders')
        || (isSignedIn() && request.auth.uid == uid);

      // الإدارة تكتب الرصيد · والزبون يكتب رقمه وحده بلا لمس النقاط
      allow create, update: if canDo('customers') || canDo('orders')
        || (isSignedIn()
        && request.auth.uid == uid
        && (pointsUntouched() || pointsSpentOnly())
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20);

      allow delete: if isAdmin();

      /* ── سجلّ حركات النقاط ──
         الزبون يقرأ سجلّه (من أين جاءت نقاطه؟) ولا يكتب فيه حرفاً.
         كل سطر: كم · لماذا · لأي طلب — فالإلغاء يعرف كم يخصم. */
      match /ledger/{entryId} {
        allow read: if canDo('customers') || canDo('orders')
          || (isSignedIn() && request.auth.uid == uid);
        allow write: if canDo('customers') || canDo('orders');

        /* الزبون يسجّل **إنفاقه** وحده: سطرٌ سالب باسم رمز طلبه.
           لا يعدّله ولا يمحوه بعدها، فيبقى دليلاً على الخصم. */
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.delta is int
          && request.resource.data.delta < 0
          && request.resource.data.reason in ['redeem', 'send', 'sell']
          && request.resource.data.code == entryId
          && request.resource.data.at == request.time;
      }
    }

    /* ── الطلبات ── */
    match /orders/{orderId} {

      /* رصيد النقاط الحقيقي للزبون — من وثيقته لا من طلبه.
         بدونه يكتب الزبون `usePoints: 999999` فيطلب خصماً لا يملكه. */
      function balanceOf() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(p) && 'points' in get(p).data ? get(p).data.points : 0;
      }

      function validRedeem() {
        let d = request.resource.data;
        return !('usePoints' in d)
          || (d.usePoints is int && d.usePoints >= 0
              && d.usePoints <= balanceOf());
      }

      /* ── شراء نقاط ──
         ⚠️ الخطر: زبونٌ يطلب مليون نقطة بربع دولار، ثم تضغطين «مدفوع»
            بلا انتباه. فنشترط أن يغطّي المبلغ عدد النقاط بسعرها
            (نقطة = سنت)، ونضع سقفاً معقولاً. واللوحة تعرض العدد
            والمبلغ صريحين قبل التأكيد. */
      function validBuyPoints() {
        let d = request.resource.data;
        return !('buyPoints' in d)
          || (d.buyPoints is int
              && d.buyPoints > 0
              && d.buyPoints <= 100000
              && d.total * 100 >= d.buyPoints - 0.5);
      }

      function validNewOrder() {
        let d = request.resource.data;
        return validBuyPoints()
          && validRedeem()
          && d.uid == request.auth.uid
          && d.status == 'pending'                 // لا يبدأ الطلب مدفوعاً
          && d.total is number && d.total >= 0
          && d.code is string && d.code.size() <= 32
          && d.items is list && d.items.size() > 0 && d.items.size() <= 50
          && d.createdAt == request.time;          // لا يزوّر تاريخ الطلب
      }

      // الزبون يرى طلباته هو فقط · الأدمن يرى الكل
      allow read: if canDo('orders')
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() && validNewOrder();

      /* ── إلغاء الزبون طلبَه ──
         يُسمح له بتغيير واحد لا غير: الحالة إلى `cancelled` مع سببٍ
         مكتوب، وقبل التسليم فقط. وما عدا ذلك يبقى كما هو — لا يمسّ
         مبلغاً ولا أصنافاً ولا نقاطاً ولا يُحيي طلباً ألغاه. */
      function validCustomerCancel() {
        let d = request.resource.data;
        let o = resource.data;
        return o.uid == request.auth.uid
          && o.status != 'done' && o.status != 'cancelled'
          && d.status == 'cancelled'
          && d.cancelReason is string
          && d.cancelReason.size() >= 3
          && d.cancelReason.size() <= 300
          && d.cancelledBy == 'customer'
          && d.uid == o.uid
          && d.code == o.code
          && d.total == o.total
          && d.items == o.items
          && d.get('pointsAwarded', 0) == o.get('pointsAwarded', 0)
          && d.get('pointsSpent', 0) == o.get('pointsSpent', 0)
          && d.get('usePoints', 0) == o.get('usePoints', 0);
      }

      /* ── احترام الحجز ──
         ⚠️ لولا هذا لَفتح مساعدان الطلب نفسه فشحنه كلاهما. من حُجز
            الطلب لغيره لا يعدّله — إلا صاحبة المتجر، فهي ترى الكل
            وتفكّ الحجز عند الحاجة. */
      /* ── تأكيد الطلب المدفوع بالنقاط ──
         الزبون يؤكّد طلبه **بشرط أن يكون الخصم قد وقع فعلاً**: نبحث عن
         سطره في سجلّه باسم رمز الطلب. فلا تأكيد بلا خصم. ولا يمسّ
         شيئاً آخر: لا المبلغ ولا الأصناف ولا الرمز. */
      function pointsSelfConfirm() {
        let d = request.resource.data;
        let o = resource.data;
        let l = /databases/$(database)/documents/users/$(request.auth.uid)/ledger/$(o.code);
        return o.uid == request.auth.uid
          && o.status == 'pending'
          && d.status == 'paid'
          && d.paidBy == 'points'
          && d.total == 0
          && d.usePoints is int && d.usePoints > 0
          && d.usePoints == o.usePoints
          && d.code == o.code
          && d.items == o.items
          && exists(l)
          && get(l).data.delta == -d.usePoints;
      }

      function claimOk() {
        let c = resource.data.get('claimedBy', '');
        return isAdmin() || c == '' || c == request.auth.token.email;
      }

      // الحالة والسعر بيد الإدارة — والزبون لا يملك إلا الإلغاء أعلاه
      allow update: if (canDo('orders') && claimOk())
        || (isSignedIn() && (validCustomerCancel() || pointsSelfConfirm()));

      allow delete: if canDo('orders');

      /* بيانات التسليم الحسّاسة — كلمات مرور الحسابات المُباعة وما شابه.
         الأدمن فقط. تُسلَّم للزبون عبر واتساب لا عبر الموقع. */
      match /private/{docId} {
        allow read, write: if canDo('orders');
      }
    }

    /* ── الدردشة المباشرة ──
       لكل زبون محادثة واحدة باسم الـuid، فلا يصل أحد لمحادثة غيره.
       الخطر الحقيقي هنا انتحال صفة المتجر: زبونٌ يكتب رسالة بتوقيع
       `admin` فيقنع غيره… لذلك الزبون لا يكتب إلا `from == 'user'`. */
    match /chats/{uid} {

      function ownerOrAdmin() {
        return isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }

      allow read: if ownerOrAdmin();

      // وثيقة المحادثة: آخر سطر ووقته، لترتيب المحادثات بلوحة الإدارة
      allow create, update: if ownerOrAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();

      match /messages/{msgId} {

        function validMsg() {
          let d = request.resource.data;
          return d.text is string
            && d.text.size() > 0
            && d.text.size() <= 2000
            && d.createdAt == request.time;      // لا يزوّر وقت الرسالة
        }

        allow read: if ownerOrAdmin();

        allow create: if validMsg() && (
          (isAdmin() && request.resource.data.from == 'admin')
          // الزبون يكتب باسمه هو فقط — لا ينتحل صفة المتجر
          || (isSignedIn() && request.auth.uid == uid
              && request.resource.data.from == 'user')
        );

        // لا تعديل ولا حذف للرسائل بعد إرسالها إلا للأدمن
        allow update, delete: if isAdmin();
      }
    }

    /* ── المنتجات والأقسام والإعدادات ──
       يقرأها الجميع (متجر عام) · لا يكتبها إلا الأدمن من لوحة الإدارة */
    match /products/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /packages/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /sections/{id}  { allow read: if true; allow write: if canDo('sections'); }
    // شرائح البانر — نفس باب الأقسام
    match /slides/{id}    { allow read: if true; allow write: if canDo('sections'); }
    /* ── تكلفة الأصناف — بيانات صاحبة المتجر وحدها ──
       🔒 خارج `packages` عمداً: تلك يقرأها كل زائر (أسعار وصور)، فلو
          كانت التكلفة فيها لعرف أي شخص ربحك من كل باقة. هنا لا يقرأها
          إلا الأدمن — ولا حتى المساعد. */
    match /costs/{id}     { allow read, write: if isAdmin(); }

    // طرق الدفع — بابها المستقلّ
    match /payments/{id}  { allow read: if true; allow write: if canDo('payments'); }

    /* الإعدادات وثائق مختلفة الأغراض، فلكلٍّ بابها:
       `points` لمن فُتحت له النقاط · `faq` لمن فُتحت له الأسئلة. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin()
        || (id == 'points' && staffCan('points'))
        || (id == 'faq' && staffCan('faq'))
        || ((id == 'how' || id == 'policy') && staffCan('sections'));
      // ملاحظة: `settings/store` (أرقام التواصل) لصاحبة المتجر وحدها
    }

    /* ── أي شيء آخر: ممنوع ──
       الافتراض هو المنع، فأي مجموعة جديدة تحتاج قاعدة صريحة أعلاه. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
