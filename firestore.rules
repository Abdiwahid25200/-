rules_version = '2';

/**
 * قواعد أمان Firestore — Ramaan Store
 *
 * ⚠️ درسٌ من الموقع القديم: كانت الطلبات مصفوفة واحدة يقرأها **أي شخص**،
 *    وفيها كلمات مرور الحسابات نصّاً صريحاً. هذه القواعد تمنع ذلك نهائياً:
 *
 *    ① كل طلب وثيقة مستقلّة — لا مصفوفة عملاقة يقرأها الجميع
 *    ② الزبون يرى طلباته هو فقط، ولا يرى طلبات غيره أبداً
 *    ③ بيانات التسليم الحسّاسة (كلمات مرور الحسابات المُباعة) في مجموعة
 *      فرعية `private` لا يقرأها إلا الأدمن — حتى صاحب الطلب لا يصل لها مباشرة
 *    ④ الزبون لا يستطيع تعديل سعر أو حالة طلبه بعد إنشائه
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ── حسابُ البوّاب ──
       🔒 لا يملك شيئاً في هذا المتجر إلا حقّاً واحداً: أن يمدّ `otpUntil`.
          كلمتُه في Vercel وحدها (`GATE_PASSWORD`)، ومستقلٌّ عن حساب
          المراقبة عمداً (قرارها ٠٧-٠٨): بابٌ لكل مفتاح، فلو تسرّب أحدهما
          لم يفتح الآخر. وحتى من سرقه لا يدخل — الخَتْم يرفع مانعاً ولا
          يمنح صلاحية، ويبقى عليه أن يعرف كلمة سرّ الأدمن. */
    function isGate() {
      return request.auth != null
        && request.auth.uid == 'y0UuWGngZcabvxjIo1lxSfEND9Z2';
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    /* ── من هو الأدمن؟ ──
       وثيقة باسم الـuid داخل مجموعة admins. تُضاف يدوياً من Firebase Console،
       فلا يستطيع أحد ترقية نفسه لأن الكتابة في admins ممنوعة على الجميع. */
    function isAdminRaw() {
      return request.auth != null && exists(adminDoc());
    }

    /* ── 🔒 والخَتْم: «وهل مرّ بالرمز؟» ──
       كانت القاعدة تسأل «هل هو أدمن» وحدها، فمن عرف كلمة السرّ **وكان
       مبرمجاً** خاطب Firebase رأساً بلا المرور بشاشة الرمز — والشاشة في
       المتصفّح، والمتصفّح ليس حارساً.

       فصار الجوابُ أثراً في البيانات: تاريخٌ في المستقبل يكتبه **البوّاب**
       بعد الرمز الصحيح، عمرُه **ساعة** (قرارها ٠٧-٠٨). ولا يكتبه الأدمن
       لنفسه — ولو استطاع لعاد الباب مفتوحاً.

       ⚠️ والافتراض `request.time`: وثيقةٌ بلا `otpUntil` تعطي
          `request.time > request.time` = خطأ ⇒ **مُنِع**. فالغياب منعٌ لا
          إذن — ولا خطأَ يُرمى ولا حالةَ تُنسى. */
    function stamped() {
      return get(adminDoc()).data.get('otpUntil', request.time) > request.time;
    }

    function isAdmin() {
      return isAdminRaw() && stamped();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    /* ── المساعدون ──
       الصلاحية **للبريد** لا للمعرّف: صاحبة المتجر تعرف بريد مساعدها
       وتكتبه، أمّا المعرّف فلا يُعرف إلا بعد أوّل دخول — فلو بنينا عليه
       لَما استطاعت منح الصلاحية قبل أن يدخل.

       ⚠️ ومجموعة `staff` لا يكتبها إلا الأدمن (انظري قاعدتها أسفل):
          لو سُمح للمساعد بتعديلها لَمنح نفسه كل الأبواب في ثانية. */
    function staffDoc() {
      return /databases/$(database)/documents/staff/$(request.auth.token.email);
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(staffDoc());
    }

    function staffCan(p) {
      return isStaff()
        && get(staffDoc()).data.get('active', true) != false
        && get(staffDoc()).data.get('can', {}).get(p, false) == true;
    }

    /** الأدمن يملك كل الأبواب · والمساعد ما فُتح له وحده */
    function canDo(p) {
      return isAdmin() || staffCan(p);
    }

    /* ── وثيقتي ورصيدي ──
       🔒 **الرصيد لا يزيد ولا ينقص بوعد، بل في العملية نفسها.**
       `getAfter` تُري القاعدة حال الوثيقة **بعد** تمام العملية كلّها.
       فمن كتب حوالةً أو سطرَ إنفاقٍ في معاملةٍ لا تُنقص رصيده، رُفضت
       كتابتُه — ولا يكفي أن «ينوي» الخصم في نداءٍ تالٍ قد لا يأتي. */
    function myDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function balBefore() {
      return exists(myDoc()) ? get(myDoc()).data.get('points', 0) : 0;
    }

    /** نقص رصيدي في هذه العملية بالضبط `n` — لا أقلّ ولا وعداً */
    function paidFromBalance(n) {
      return getAfter(myDoc()).data.get('points', 0) == balBefore() - n;
    }

    /** هل هذا الرقم **لي** في دليل الأرقام؟ */
    function ownsPhone(p) {
      return p != ''
        && exists(/databases/$(database)/documents/phones/$(p))
        && get(/databases/$(database)/documents/phones/$(p)).data.get('uid', '')
           == request.auth.uid;
    }

    /**
     * رقم هاتف صاحب الجلسة — مفتاح الحوالات بين الزبائن.
     *
     * 🔒 **ولا يكفي أن يكتبه في وثيقته**: كل زبونٍ يكتب حقل `phone` في
     *    وثيقته بيده، فلو بُني الاستلام عليه وحده لَكتب أحدُهم رقم غيره
     *    واستلم حوالاته. فالرقم لا يُعتدّ به إلا إن كان **مسجَّلاً باسمه
     *    في `phones`** — وتلك وثيقةٌ لا يبدّلها غير صاحبها.
     */
    function myPhone() {
      let p = exists(myDoc()) ? get(myDoc()).data.get('phone', '') : '';
      return ownsPhone(p) ? p : '';
    }

    /* ── حوالات النقاط بين الزبائن ──
       🔑 الزبون لا يملك زيادة رصيد أحد. فالحوالة **وثيقةٌ تُثبت الإذن**:
          يكتبها المرسِل بعد خصم رصيده، ويستلمها صاحب الرقم فتزيد نقاطه.
       ⚠️ ولا تُستلم مرّتين: القاعدة تشترط `claimed == false` قبل الاستلام،
          ومحاولتان متزامنتان تتصادمان على الوثيقة نفسها فتنجح واحدة. */
    /* ── دليل الأرقام ──
       وثيقةٌ اسمها الرقم وفيها صاحبه، ليُعرف: هل لهذا الرقم حساب؟
       ⚠️ `get` وحده — **لا سرد**: لو سُمح بسرد المجموعة لقُرئت أرقام
          الزبائن كلّها. وهكذا لا يُكشف إلا ما سأل عنه من يعرفه سلفاً.
       ⚠️ ولا يُختطف رقم غيرك: الإنشاء متى كانت الوثيقة غائبة، والتعديل
          لصاحبها وحده. ولولا ذلك لوجّه أحدهم حوالات غيره إلى نفسه. */
    match /phones/{phone} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      /* ويحرّره عند حذف حسابه، وإلا بقي محجوزاً لحسابٍ لا وجود له
         فلا يستطيع التسجيل برقمه نفسه لو عاد. */
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    /* ── رموز الدعوة ──
       وثيقةٌ اسمها الرمز وفيها صاحبه — بها يُعرف الداعي بلا سرد
       المستخدمين. `get` وحده كدليل الأرقام: من يعرف الرمز يستعمله،
       ولا يقرأ أحدٌ قائمة الرموز. ولا يُختطف رمزُ غيرك: التعديل ممنوع. */
    match /refcodes/{code} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /transfers/{code} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.from == request.auth.uid
                             || resource.data.toPhone == myPhone()));

      /* المرسِل يكتبها باسمه ولا يكتبها مستلَمة.
         🚨 **ولا تُكتب حوالةٌ إلا برصيدٍ ينقص معها في العملية نفسها.**
            وبدون هذا الشرط كان أيّ زبونٍ يفتح أدوات المتصفّح فيكتب
            حوالةً بمليون نقطة لا يملكها، ثم يستلمها بحسابٍ ثانٍ —
            **نقاطٌ تُخلق من العدم**. والعميل يخصم في معاملةٍ واحدة
            أصلاً (`sendPointsTo`)، فلا يتغيّر شيء في الاستعمال. */
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.points is int
        && request.resource.data.points > 0
        && request.resource.data.toPhone is string
        && request.resource.data.toPhone.size() >= 7
        && request.resource.data.claimed == false
        && request.resource.data.at == request.time
        && paidFromBalance(request.resource.data.points);

      // ولا يعلّمها مستلَمة إلا صاحب الرقم، ومرّة واحدة
      allow update: if isSignedIn()
        && resource.data.claimed == false
        && resource.data.toPhone == myPhone()
        && request.resource.data.claimed == true
        && request.resource.data.toUid == request.auth.uid
        && request.resource.data.points == resource.data.points
        && request.resource.data.from == resource.data.from;

      allow delete: if isAdmin();
    }

    /* ── 🎟️ رموز الخصم ──
       وثيقةٌ اسمها الرمز — كدليل الأرقام ورموز الدعوة: **`get` وحده لا
       سرد**. فمن يعرف رمزاً يستعمله، ولا يقرأ أحدٌ قائمة الرموز كلّها
       فيجرّبها واحداً واحداً.

       ⚠️ **والزبون لا يملك إلا زيادة العدّاد**: `used + 1` ولا حرفَ
          غيرها (`affectedKeys().hasOnly`). ولولا هذا الشرط لَفتح رمزاً
          مطفأً، أو رفع قيمته إلى تسعين بالمئة، أو مسح تاريخ انتهائه —
          وكلّها حقولٌ في الوثيقة نفسها التي يكتب فيها. */
    match /promos/{code} {
      allow get: if true;
      allow list: if canDo('products');
      allow create, delete: if canDo('products');

      allow update: if canDo('products')
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
            && request.resource.data.used == resource.data.get('used', 0) + 1);

      /* 🛡️ **ختمُ «استعملتُه»** — وثيقةٌ باسم الزبون تحت الرمز.
         ⚠️ **إنشاءٌ بلا كتابةٍ فوقه**: `create` تفشل إن كانت الوثيقة
            موجودةً أصلاً، و`update` ممنوعة — فلا يُستعمل الرمز مرّتين
            من الحساب نفسه **ولو عُدّل الكود في المتصفّح**. والمنعُ من
            الخادم لا من الشاشة.
         ⚠️ **ويقرأ كلٌّ ختمَه وحده**: لا يعرف زبونٌ من استعمل الرمز. */
      match /claims/{uid} {
        allow get: if isSignedIn() && request.auth.uid == uid;
        allow list: if canDo('products');
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
        allow delete: if canDo('products');
      }
    }

    match /staff/{email} {
      // المساعد يقرأ وثيقته ليعرف أبوابه · وصاحبة المتجر تقرأ الكل
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.token.email == email);
      // 🔒 الكتابة لصاحبة المتجر وحدها — لا ترقية ذاتية
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      /* ⚠️ **القراءة بلا ختمٍ عمداً** (`isAdminRaw`): من انتهى ختمُه هو
         بالضبط من يطلب الرمز، وبابُ الرمز يقرأ هذه الوثيقة ليعرف إلى أي
         بريدٍ يرسل. ولو اشترطنا الختم لَما أُرسل رمزٌ لأحدٍ أبداً.
         والوثيقة لا تحمل سرّاً — وجودُها هو كل ما فيها. */
      allow read: if isAdminRaw();

      /* 🔒 **ولا تُصنع ولا تُمحى من الشبكة** — من Firebase Console فقط.
         و`create` ممنوعةٌ صراحةً لأن كتابة حقلٍ في وثيقةٍ غائبة **تُنشئها**:
         فلولا هذا السطر لَصنع خطأٌ في ختمِ معرّفٍ غريب أدمناً جديداً. */
      allow create, delete: if false;

      /* 🔒 والبوّاب يمدّ `otpUntil` وحده — لا حقلاً غيره، ولا وثيقةً غيرها */
      allow update: if isGate()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['otpUntil']);
    }

    /* ── ملفّات الزبائن ──
       رقم الهاتف الذي يُدخله الزبون بعد الدخول بجوجل (للتسليم عبر واتساب).
       كل زبون يقرأ ويكتب وثيقته وحده — ولا يرى أرقام غيره أبداً. */
    match /users/{uid} {

      /* 🔒 النقاط رصيدٌ ماليّ: الزبون **يقرأه ولا يكتبه**.
         بدون هذا الشرط يفتح أي زبون أدوات المتصفّح ويكتب لنفسه ما شاء،
         ثم يشتري به. الكتابة للأدمن وحده — من لوحة الإدارة. */
      function pointsUntouched() {
        let inNew = 'points' in request.resource.data;
        let inOld = resource != null && 'points' in resource.data;
        return (!inNew && !inOld)
          || (inNew && inOld
              && request.resource.data.points == resource.data.points);
      }

      /* الإنفاق: الرصيد **ينقص ولا يزيد**. أسوأ ما يفعله الزبون بنفسه
         أن يُتلف نقاطه، ولا يستطيع أن يخلق منها واحدة. */
      function pointsSpentOnly() {
        return resource != null
          && 'points' in resource.data
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points < resource.data.points;
      }

      /* الزيادة الوحيدة المسموحة للزبون: استلام حوالة. القاعدة تفتح
         الحوالة المذكورة في `lastClaim` وتتحقّق: غير مستلَمة، وبرقمه،
         وبالفارق نفسه. فلا نقطة تدخل رصيداً بلا حوالة تفسّرها. */
      /**
       * 🚨 **وتُختم الحوالة مستلَمةً في العملية نفسها** (`getAfter`).
       *
       * وبدون هذا الشرط كان الشرطُ الوحيد أن تكون الحوالة **غير
       * مستلَمة** — وهي تبقى كذلك ما لم تُختم. فيعيد الزبون الكتابة
       * عشر مرّات بالحوالة نفسها فيزيد رصيده عشراً. والعميل يختمها
       * ويزيد الرصيد في معاملةٍ واحدة أصلاً (`claimIncoming`).
       */
      function claimsTransfer() {
        let d = request.resource.data;
        let t = /databases/$(database)/documents/transfers/$(d.get('lastClaim', 'x'));
        return 'lastClaim' in d
          && exists(t)
          && get(t).data.claimed == false
          && getAfter(t).data.claimed == true
          && getAfter(t).data.toUid == request.auth.uid
          && get(t).data.toPhone == myPhone()
          && d.points is int
          && d.points == resource.data.get('points', 0) + get(t).data.points;
      }

      /* ── الدعوة ──
         الزبون يكتب **من دعاه** مرّة واحدة ولا يبدّلها، ولا يدعو نفسه.
         ⚠️ ولولا «مرّة واحدة» لَبدّل داعيَه قبل كل طلبٍ فجنى مراراً. */
      function refOk() {
        let d = request.resource.data;
        let had = resource != null && 'referredBy' in resource.data;
        return !('referredBy' in d)
          || (had && d.referredBy == resource.data.referredBy)
          || (!had && d.referredBy is string
              && d.referredBy.size() > 0
              && d.referredBy != request.auth.uid);
      }

      /* 🔒 حقولُ إدارةٍ لا يكتبها الزبون: عدد دعواته وما كسبه منها
         وختمُ أنه كوفئ. ولو كتبها لَختم نفسه أو رفع عدّاده كما شاء. */
      function adminFieldsKept(f) {
        return request.resource.data.get(f, null)
          == (resource != null ? resource.data.get(f, null) : null);
      }

      allow read: if canDo('customers') || canDo('orders')
        || (isSignedIn() && request.auth.uid == uid);

      // الإدارة تكتب الرصيد · والزبون يكتب رقمه وحده بلا لمس النقاط
      allow create, update: if canDo('customers') || canDo('orders')
        || (isSignedIn()
        && request.auth.uid == uid
        && (pointsUntouched() || pointsSpentOnly() || claimsTransfer())
        && refOk()
        && adminFieldsKept('refPaid')
        && adminFieldsKept('refCount')
        && adminFieldsKept('refEarned')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 20);

      /* 🔒 **حذف الحساب من داخل التطبيق** — تشترطه Google Play على كل
         تطبيق فيه تسجيل دخول، وبدونه يُرفض. فصاحب الوثيقة يمحوها.
         ⚠️ ولا يضرّ ذلك شيئاً: رصيدُه يذهب معها (وقد قيل له بالرقم قبل
            الضغط)، وطلباته في `orders` لا تُمسّ — سِجلٌّ محاسبيّ. */
      allow delete: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);

      /* ── سجلّ حركات النقاط ──
         الزبون يقرأ سجلّه (من أين جاءت نقاطه؟) ولا يكتب فيه حرفاً.
         كل سطر: كم · لماذا · لأي طلب — فالإلغاء يعرف كم يخصم. */
      match /ledger/{entryId} {
        allow read: if canDo('customers') || canDo('orders')
          || (isSignedIn() && request.auth.uid == uid);
        allow write: if canDo('customers') || canDo('orders');

        /* الزبون يسجّل **إنفاقه** وحده: سطرٌ سالب باسم رمز طلبه.
           لا يعدّله ولا يمحوه بعدها، فيبقى دليلاً على الخصم.

           🚨 **والسطر السالب لا يُكتب إلا ورصيدُه ينقص معه.**
              وبدون هذا الشرط كان الزبون يكتب سطر «أنفقتُ ٥٠٠» بلا أن
              ينقص رصيده، ثم يقلب طلبه إلى «مدفوع» بموجبه
              (`pointsSelfConfirm`) — فيشتري بالنقاط نفسها أبداً.
              والعميل يكتب السطر والخصم في معاملةٍ واحدة أصلاً
              (`payWithPoints` · `spendAndRequest` · `sendPointsTo`). */
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.code == entryId
          && request.resource.data.at == request.time
          && request.resource.data.delta is int
          && (
            /* إنفاق: سالبٌ دائماً */
            (request.resource.data.delta < 0
             && request.resource.data.reason in ['redeem', 'send', 'sell']
             && paidFromBalance(-request.resource.data.delta))
            /* أو استلام حوالة: موجبٌ بقيمة الحوالة نفسها وباسم رمزها */
            || (request.resource.data.delta > 0
                && request.resource.data.reason == 'received'
                && exists(/databases/$(database)/documents/transfers/$(entryId))
                && get(/databases/$(database)/documents/transfers/$(entryId)).data.points
                   == request.resource.data.delta)
          );
      }
    }

    /* ── الطلبات ── */
    match /orders/{orderId} {

      /* رصيد النقاط الحقيقي للزبون — من وثيقته لا من طلبه.
         بدونه يكتب الزبون `usePoints: 999999` فيطلب خصماً لا يملكه. */
      function balanceOf() {
        let p = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(p) && 'points' in get(p).data ? get(p).data.points : 0;
      }

      function validRedeem() {
        let d = request.resource.data;
        return !('usePoints' in d)
          || (d.usePoints is int && d.usePoints >= 0
              && d.usePoints <= balanceOf());
      }

      /* ── شراء نقاط ──
         ⚠️ الخطر: زبونٌ يطلب مليون نقطة بربع دولار، ثم تضغطين «مدفوع»
            بلا انتباه. فنشترط أن يغطّي المبلغ عدد النقاط بسعرها
            (نقطة = سنت)، ونضع سقفاً معقولاً. واللوحة تعرض العدد
            والمبلغ صريحين قبل التأكيد. */
      function validBuyPoints() {
        let d = request.resource.data;
        return !('buyPoints' in d)
          || (d.buyPoints is int
              && d.buyPoints > 0
              && d.buyPoints <= 100000
              && d.total * 100 >= d.buyPoints - 0.5);
      }

      function validNewOrder() {
        let d = request.resource.data;
        return validBuyPoints()
          && validRedeem()
          && d.uid == request.auth.uid
          && d.status == 'pending'                 // لا يبدأ الطلب مدفوعاً
          && d.total is number && d.total >= 0
          && d.code is string && d.code.size() <= 32
          && d.items is list && d.items.size() > 0 && d.items.size() <= 50
          && d.createdAt == request.time;          // لا يزوّر تاريخ الطلب
      }

      // الزبون يرى طلباته هو فقط · الأدمن يرى الكل
      allow read: if canDo('orders')
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn() && validNewOrder();

      /* ── إلغاء الزبون طلبَه ──
         يُسمح له بتغيير واحد لا غير: الحالة إلى `cancelled` مع سببٍ
         مكتوب، وقبل التسليم فقط. وما عدا ذلك يبقى كما هو — لا يمسّ
         مبلغاً ولا أصنافاً ولا نقاطاً ولا يُحيي طلباً ألغاه. */
      function validCustomerCancel() {
        let d = request.resource.data;
        let o = resource.data;
        return o.uid == request.auth.uid
          && o.status != 'done' && o.status != 'cancelled'
          && d.status == 'cancelled'
          && d.cancelReason is string
          && d.cancelReason.size() >= 3
          && d.cancelReason.size() <= 300
          && d.cancelledBy == 'customer'
          && d.uid == o.uid
          && d.code == o.code
          && d.total == o.total
          && d.items == o.items
          && d.get('pointsAwarded', 0) == o.get('pointsAwarded', 0)
          && d.get('pointsSpent', 0) == o.get('pointsSpent', 0)
          && d.get('usePoints', 0) == o.get('usePoints', 0);
      }

      /* ── احترام الحجز ──
         ⚠️ لولا هذا لَفتح مساعدان الطلب نفسه فشحنه كلاهما. من حُجز
            الطلب لغيره لا يعدّله — إلا صاحبة المتجر، فهي ترى الكل
            وتفكّ الحجز عند الحاجة. */
      /* ── تأكيد الطلب المدفوع بالنقاط ──
         الزبون يؤكّد طلبه **بشرط أن يكون الخصم قد وقع فعلاً**: نبحث عن
         سطره في سجلّه باسم رمز الطلب. فلا تأكيد بلا خصم. ولا يمسّ
         شيئاً آخر: لا المبلغ ولا الأصناف ولا الرمز. */
      function pointsSelfConfirm() {
        let d = request.resource.data;
        let o = resource.data;
        let l = /databases/$(database)/documents/users/$(request.auth.uid)/ledger/$(o.code);
        return o.uid == request.auth.uid
          && o.status == 'pending'
          && d.status == 'paid'
          && d.paidBy == 'points'
          && d.total == 0
          && d.usePoints is int && d.usePoints > 0
          && d.usePoints == o.usePoints
          && d.code == o.code
          && d.items == o.items
          && exists(l)
          && get(l).data.delta == -d.usePoints;
      }

      /* ⚠️ **وللحجز مهلة**: مساعدٌ قَبِل طلباتٍ ثم غاب كان يبتلعها معه —
            لا يراها مساعدٌ آخر ولا يفكّها إلا صاحبة المتجر، والزبون
            ينتظر. بعد نصف ساعةٍ بلا حركة يعود الطلب للجميع.
            (والرقم نفسه في `CLAIM_MINUTES` بـ`lib/adminOrders.ts`.) */
      function claimOk() {
        let c = resource.data.get('claimedBy', '');
        let at = resource.data.get('claimedAt', request.time);
        return isAdmin()
          || c == ''
          || c == request.auth.token.email
          || at < request.time - duration.value(30, 'm');
      }

      /* 🔒 ── الحالة النهائية لصاحبة المتجر وحدها ── (قرارها)
         ⚠️ المساعد يدفع الطلب إلى الأمام: بانتظار ⇒ مقبول ⇒ منتهٍ.
            أمّا المنتهي والمرفوض فبابٌ مغلق عليه: طلبٌ سُلّم ثم أُعيد
            إلى «بانتظار» يُشحن مرّتين، وطلبٌ أُلغي ثم أُحيي يُعيد
            نقاطاً سُحبت. وهي وحدها من يصحّح فهي وحدها من يتحمّل.

         ⚠️ ويُستثنى **تسوية نقاطٍ عالقة** بعد إلغاء الزبون: الحالة
            تبقى `cancelled` ولا ترجع، فهي تصحيحٌ لا رجوع. */
      function finalState() {
        let s = resource.data.status;
        return s == 'done' || s == 'cancelled';
      }

      function settlingOnly() {
        return resource.data.status == 'cancelled'
          && request.resource.data.status == 'cancelled';
      }

      function statusOk() {
        return isAdmin() || !finalState() || settlingOnly();
      }

      // الحالة والسعر بيد الإدارة — والزبون لا يملك إلا الإلغاء أعلاه
      allow update: if (canDo('orders') && claimOk() && statusOk())
        || (isSignedIn() && (validCustomerCancel() || pointsSelfConfirm()));

      allow delete: if canDo('orders');

      /* بيانات التسليم الحسّاسة — كلمات مرور الحسابات المُباعة وما شابه.
         الأدمن فقط. تُسلَّم للزبون عبر واتساب لا عبر الموقع. */
      match /private/{docId} {
        allow read, write: if canDo('orders');
      }
    }

    /* ── الدردشة المباشرة ──
       لكل زبون محادثة واحدة باسم الـuid، فلا يصل أحد لمحادثة غيره.
       الخطر الحقيقي هنا انتحال صفة المتجر: زبونٌ يكتب رسالة بتوقيع
       `admin` فيقنع غيره… لذلك الزبون لا يكتب إلا `from == 'user'`. */
    match /chats/{uid} {

      /* صاحبةُ المتجر ومن فُتح له باب الدردشة — وصاحب المحادثة نفسه.
         ⚠️ والمساعد يردّ **باسم المتجر**، فبابه بابٌ مستقلّ (`chat`):
            من يشحن الطلبات ليس بالضرورة من يتكلّم مع الزبائن. */
      /* ⚠️ صاحب المحادثة **أوّلاً**: شرطٌ بلا قراءة وثائق، فمحادثة
         الزبون العادي لا تكلّف قراءتين في كل رسالة. */
      function ownerOrAdmin() {
        return (isSignedIn() && request.auth.uid == uid) || canDo('chat');
      }

      /* ── حجز المحادثة ──
         ⚠️ محادثةٌ يدخلها مساعدان معاً كارثة: يردّان بجوابين مختلفين
            على السؤال نفسه فيظنّ الزبون المتجر مرتبكاً. فأوّلُ من فتحها
            يحجزها، ومن سواه لا يكتب فيها.

         ⚠️ **وللحجز مهلة**: مساعدٌ أغلق جوّاله كان سيُقفلها على الجميع
            إلى الأبد. بعد ربع ساعةٍ بلا حركة تعود المحادثة للجميع. */
      function chatDoc() {
        return /databases/$(database)/documents/chats/$(uid);
      }

      function heldBy() {
        return exists(chatDoc()) ? get(chatDoc()).data.get('handledBy', '') : '';
      }

      function heldAt() {
        return exists(chatDoc())
          ? get(chatDoc()).data.get('handledAt', request.time)
          : request.time;
      }

      /** حرّةٌ لي: لا حاجز · أو أنا · أو مضى على الحجز ربع ساعة */
      function mine() {
        return isAdmin()
          || heldBy() == ''
          || heldBy() == request.auth.token.email
          || heldAt() < request.time - duration.value(15, 'm');
      }

      allow read: if ownerOrAdmin();

      // وثيقة المحادثة: آخر سطر ووقته، لترتيب المحادثات بلوحة الإدارة
      /* الزبون يكتب وثيقته · والمساعد لا يحجزها إن كانت محجوزة لغيره */
      allow create, update: if request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time
        && (
          (isSignedIn() && request.auth.uid == uid)
          || (canDo('chat') && mine())
        );

      allow delete: if isAdmin();

      match /messages/{msgId} {

        function validMsg() {
          let d = request.resource.data;
          return d.text is string
            && d.text.size() > 0
            && d.text.size() <= 2000
            && d.createdAt == request.time;      // لا يزوّر وقت الرسالة
        }

        allow read: if ownerOrAdmin();

        allow create: if validMsg() && (
          (canDo('chat') && mine() && request.resource.data.from == 'admin')
          // الزبون يكتب باسمه هو فقط — لا ينتحل صفة المتجر
          || (isSignedIn() && request.auth.uid == uid
              && request.resource.data.from == 'user')
        );

        // لا تعديل ولا حذف للرسائل بعد إرسالها إلا للأدمن
        allow update, delete: if isAdmin();
      }
    }

    /* ── المنتجات والأقسام والإعدادات ──
       يقرأها الجميع (متجر عام) · لا يكتبها إلا الأدمن من لوحة الإدارة */
    match /products/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /packages/{id}  { allow read: if true; allow write: if canDo('products'); }
    match /sections/{id}  { allow read: if true; allow write: if canDo('sections'); }
    // شرائح البانر — نفس باب الأقسام
    match /slides/{id}    { allow read: if true; allow write: if canDo('sections'); }
    /* ── تكلفة الأصناف — بيانات صاحبة المتجر وحدها ──
       🔒 خارج `packages` عمداً: تلك يقرأها كل زائر (أسعار وصور)، فلو
          كانت التكلفة فيها لعرف أي شخص ربحك من كل باقة. هنا لا يقرأها
          إلا الأدمن — ولا حتى المساعد. */
    match /costs/{id}     { allow read, write: if isAdmin(); }

    // طرق الدفع — بابها المستقلّ
    match /payments/{id}  { allow read: if true; allow write: if canDo('payments'); }

    /* الإعدادات وثائق مختلفة الأغراض، فلكلٍّ بابها:
       `points` لمن فُتحت له النقاط · `faq` لمن فُتحت له الأسئلة. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin()
        || (id == 'points' && staffCan('points'))
        || (id == 'faq' && staffCan('faq'))
        || ((id == 'how' || id == 'policy') && staffCan('sections'))
        /* عدّاد الثقة: يكتبه من يسلّم الطلبات، لأنه يُحدَّث لحظة التسليم.
           ولا يُقرأ منه شيء خاص — عددٌ ومجموع دقائق لا أكثر. */
        || (id == 'stats' && canDo('orders'));
      // ملاحظة: `settings/store` (أرقام التواصل) لصاحبة المتجر وحدها
    }

    /* ── أي شيء آخر: ممنوع ──
       الافتراض هو المنع، فأي مجموعة جديدة تحتاج قاعدة صريحة أعلاه. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
